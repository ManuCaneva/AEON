{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEON",
  "version": "0.1.3",
  "identifier": "com.aeon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AEON",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["com.aeon"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMDcyMjA2REI5NzAzNUQKUldSZEE1ZmJCaUlIYTRGbWxEQ2VEN3RSSWxrdk1abTcyalc5QTdzR3hjek81VnBvcmNOeGlEWm4K",
      "endpoints": ["https://github.com/ManuCaneva/AEON/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "shortDescription": "Made for Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
