{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the pomodoro mini window",
  "windows": ["main", "pomodoro-mini"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://oauth2.googleapis.com/*" },
        { "url": "https://www.googleapis.com/*" }
      ]
    },
    "http:allow-fetch-cancel",
    "http:allow-fetch-read-body",
    "http:allow-fetch-send",
    "deep-link:default",
    "deep-link:allow-is-registered",
    "deep-link:allow-register",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$HOME/Applications" },
        { "path": "$HOME/Applications/**" },
        { "path": "$HOME/.local/share/applications" },
        { "path": "$HOME/.local/share/applications/**" },
        { "path": "$HOME/.local/share/icons/hicolor/256x256/apps" },
        { "path": "$HOME/.local/share/icons/hicolor/256x256/apps/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/.local/share/applications/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/.local/share/icons/hicolor/256x256/apps/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$HOME/.local/share/icons/hicolor/icon-theme.cache" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "$HOME/**" }]
    },
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
